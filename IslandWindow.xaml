<Window x:Class="DesktopOverlay.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DesktopOverlay"
        Title="Island" Width="560" Height="210" Top="0"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" Topmost="True"
        FontFamily="{DynamicResource Ui}" Foreground="White"
        TextOptions.TextFormattingMode="Display">
    <Grid x:Name="IslandRoot">
        <!-- The ears only show in the docked form, where they curve the island into the screen edge -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top">
        <Path x:Name="EarLeft" Width="16" Height="16" VerticalAlignment="Top" Data="M0,0 L16,0 L16,16 Q16,0 0,0 Z" Visibility="Collapsed"/>
        <Border x:Name="Island" Width="240" Height="34" HorizontalAlignment="Center" VerticalAlignment="Top"
                Background="#F7060608" CornerRadius="17" Margin="0,8,0,0" ClipToBounds="True"
                MouseEnter="Island_MouseEnter" MouseLeave="Island_MouseLeave" MouseRightButtonUp="Island_RightClick">
            <Grid>
                <!-- Compact pill -->
                <Grid x:Name="Compact" Height="34" VerticalAlignment="Top" Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="CompactArt" Width="22" Height="22" CornerRadius="6" Background="#22FFFFFF">
                        <TextBlock x:Name="CompactArtIcon" Text="&#xE8D6;" FontFamily="{StaticResource Icons}" FontSize="11"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="CompactTitle" Grid.Column="1" Margin="9,0" VerticalAlignment="Center"
                               FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Height="14">
                        <Rectangle x:Name="Eq1" Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Fill="White" Margin="1,0" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.3"/></Rectangle.RenderTransform></Rectangle>
                        <Rectangle x:Name="Eq2" Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Fill="White" Margin="1,0" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.3"/></Rectangle.RenderTransform></Rectangle>
                        <Rectangle x:Name="Eq3" Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Fill="White" Margin="1,0" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.3"/></Rectangle.RenderTransform></Rectangle>
                        <Rectangle x:Name="Eq4" Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Fill="White" Margin="1,0" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.3"/></Rectangle.RenderTransform></Rectangle>
                    </StackPanel>
                </Grid>

                <!-- Expanded panel (fixed size so nothing reflows while the island animates) -->
                <Grid x:Name="Expanded" Width="480" Height="160" HorizontalAlignment="Center" VerticalAlignment="Top"
                      RenderTransformOrigin="0.5,0" Opacity="0" IsHitTestVisible="False">
                    <Grid.CacheMode><BitmapCache EnableClearType="False" SnapsToDevicePixels="True"/></Grid.CacheMode>
                    <Grid x:Name="HomeView" Margin="16,16,16,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="98"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="98"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="132"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="Art" Width="98" Height="98" CornerRadius="16" Background="#1FFFFFFF"
                                Cursor="Hand" MouseLeftButtonUp="Art_Click">
                            <TextBlock x:Name="ArtIcon" Text="&#xE8D6;" FontFamily="{StaticResource Icons}" FontSize="30"
                                       Foreground="{StaticResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <Grid Grid.Column="1" Margin="12,0,20,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="TitleText" Text="Nichts wird abgespielt" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="Artist" Grid.Row="1" FontSize="11" FontWeight="SemiBold" Margin="0,3,0,0"
                                       Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis"/>
                            <ProgressBar x:Name="Progress" Grid.Row="3" Style="{StaticResource Bar}" Height="3"/>
                            <Grid Grid.Row="4" Margin="0,5,0,0">
                                <TextBlock x:Name="PosText" Text="0:00" FontSize="10" FontWeight="SemiBold"/>
                                <TextBlock x:Name="DurText" Text="0:00" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Grid.Row="5" Margin="0,2,0,-4">
                                <Button Style="{StaticResource IconButton}" Content="&#xE892;" FontSize="14" HorizontalAlignment="Left" Click="Prev_Click"/>
                                <Button x:Name="PlayBtn" Style="{StaticResource IconButton}" Content="&#xE768;" FontSize="16" HorizontalAlignment="Center" Click="Play_Click"/>
                                <Button Style="{StaticResource IconButton}" Content="&#xE893;" FontSize="14" HorizontalAlignment="Right" Click="Next_Click"/>
                            </Grid>
                        </Grid>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <Grid>
                                <TextBlock Text="CPU" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Dim}" VerticalAlignment="Bottom"/>
                                <TextBlock x:Name="CpuText" Text="0%" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <ProgressBar x:Name="CpuBar" Style="{StaticResource Bar}" Margin="0,5,0,0"/>
                            <Grid Margin="0,14,0,0">
                                <TextBlock Text="RAM" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Dim}" VerticalAlignment="Bottom"/>
                                <TextBlock x:Name="RamText" Text="0 / 0 GB" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <ProgressBar x:Name="RamBar" Style="{StaticResource Bar}" Margin="0,5,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <TextBlock Text="&#xE896;" FontFamily="{StaticResource Icons}" FontSize="9" VerticalAlignment="Center"/>
                                <TextBlock x:Name="DownText" FontSize="10" FontWeight="SemiBold" Margin="4,0,12,0" Width="52"/>
                                <TextBlock Text="&#xE898;" FontFamily="{StaticResource Icons}" FontSize="9" VerticalAlignment="Center"/>
                                <TextBlock x:Name="UpText" FontSize="10" FontWeight="SemiBold" Margin="4,0,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Volume -->
                        <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="MuteBtn" Style="{StaticResource IconButton}" Content="&#xE767;" FontSize="13" Padding="6,3"
                                    Margin="-6,0,6,0" Click="Mute_Click"/>
                            <local:VolumeSlider x:Name="VolSlider" Grid.Column="1"/>
                            <TextBlock x:Name="VolText" Grid.Column="2" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <Button x:Name="GearBtn" Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE713;" FontSize="12" Padding="6,3" Margin="6,0,-6,0" Click="Settings_Click" ToolTip="Einstellungen"/>
                        </Grid>
                    </Grid>
                    <!-- Settings page (gear button); built in code -->
                    <Grid x:Name="SettingsView" Margin="18,10,18,10" Visibility="Collapsed" Opacity="0"/>
                </Grid>
            </Grid>
        </Border>
        <Path x:Name="EarRight" Width="16" Height="16" VerticalAlignment="Top" Data="M16,0 L0,0 L0,16 Q0,0 16,0 Z" Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</Window>
