<Window x:Class="DesktopOverlay.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DesktopOverlay"
        Title="Island" Width="900" Height="380" Top="0"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" Topmost="True"
        FontFamily="{DynamicResource Ui}" Foreground="White"
        TextOptions.TextFormattingMode="Display">
    <Grid x:Name="IslandRoot">
        <!-- Tab on the right edge of the open island: arrange or remove the desktop widgets; a second click saves -->
        <Border x:Name="EditTab" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="859,22,0,0" Width="24" Height="56"
                Background="#0A0A0A" BorderBrush="#3A3A3A" BorderThickness="0,1,1,1" CornerRadius="0,4,4,0" Cursor="Hand"
                Opacity="0" IsHitTestVisible="False" ToolTip="Widgets anordnen"
                MouseEnter="Island_MouseEnter" MouseLeave="Island_MouseLeave" MouseLeftButtonUp="EditTab_Click">
            <TextBlock x:Name="EditGlyph" Text="&#xE70F;" FontFamily="{StaticResource Icons}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <Border x:Name="Island" Width="240" Height="34" HorizontalAlignment="Center" VerticalAlignment="Top"
                Background="#01000000" CornerRadius="17" Margin="0,8,0,0" ClipToBounds="True"
                MouseEnter="Island_MouseEnter" MouseLeave="Island_MouseLeave" MouseRightButtonUp="Island_RightClick">
            <Grid>
                <!-- Compact pill -->
                <Grid x:Name="Compact" Height="34" Width="216" VerticalAlignment="Top" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="CompactArt" Width="22" Height="22" CornerRadius="2" Background="#22FFFFFF">
                        <TextBlock x:Name="CompactArtIcon" Text="&#xE8D6;" FontFamily="{StaticResource Icons}" FontSize="11"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="CompactTitle" Grid.Column="1" Margin="9,0" VerticalAlignment="Center"
                               FontFamily="{StaticResource Mono}" FontSize="11" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                    <!-- Room for the equalizer, which the surface draws on the GPU -->
                    <Border Grid.Column="2" Width="24"/>
                    <!-- Without music the pixel character lives here, walking or resting; the time moves to the right -->
                    <local:PixelPet x:Name="NotchPet" Compact="True" Grid.ColumnSpan="3" Height="32" VerticalAlignment="Bottom" Margin="4,0,4,1" Visibility="Collapsed"/>
                    <!-- How far the song is: a hairline under the title -->
                    <Grid x:Name="CompactTrack" Grid.Column="1" Grid.ColumnSpan="2" Height="2" VerticalAlignment="Bottom" Margin="9,0,2,5" Visibility="Collapsed">
                        <Border Background="#33FFFFFF"/>
                        <Border x:Name="CompactFill" Background="#E6E6E6" HorizontalAlignment="Left" Width="0"/>
                    </Grid>
                </Grid>

                <!-- Expanded panel (fixed size so nothing reflows while the island animates) -->
                <Grid x:Name="Expanded" Width="820" Height="330" HorizontalAlignment="Center" VerticalAlignment="Top" Opacity="0" IsHitTestVisible="False">
                    <Grid.CacheMode><BitmapCache EnableClearType="False" SnapsToDevicePixels="True"/></Grid.CacheMode>
                    <Grid Margin="16,12,16,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Tabs -->
                        <StackPanel x:Name="Tabs" Orientation="Horizontal"/>
                        <Button x:Name="GearBtn" Style="{StaticResource IconButton}" Content="&#xE713;" FontSize="14" Padding="9,6"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Click="Settings_Click" ToolTip="Einstellungen"/>

                        <!-- Start: music and tools -->
                        <Grid x:Name="StartPage" Grid.Row="1" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="446"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="46"/>
                            </Grid.RowDefinitions>

                            <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="2" Padding="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Cover and title are drawn by the surface; these stay as click target and fallback -->
                                    <Border x:Name="Art" Width="120" Height="120" VerticalAlignment="Top" CornerRadius="2" Background="#1FFFFFFF" Cursor="Hand" MouseLeftButtonUp="Art_Click">
                                        <TextBlock x:Name="ArtIcon" Text="&#xE8D6;" FontFamily="{StaticResource Icons}" FontSize="30"
                                                   Foreground="{StaticResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Grid Grid.Column="1" Margin="14,0,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="18"/>
                                            <RowDefinition Height="44"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock x:Name="SourceText" Style="{StaticResource Tag}" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Grid.Row="1">
                                            <TextBlock x:Name="TitleText" Text="Nichts wird abgespielt" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="Artist" FontFamily="{StaticResource Mono}" FontSize="11" Margin="0,3,0,0" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <ProgressBar x:Name="Progress" Grid.Row="3" Style="{StaticResource Bar}" Height="3"/>
                                        <Grid Grid.Row="4" Margin="0,5,0,0">
                                            <TextBlock x:Name="PosText" Text="0:00" Style="{StaticResource Tag}"/>
                                            <TextBlock x:Name="DurText" Text="0:00" Style="{StaticResource Tag}" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,-4">
                                            <Button Style="{StaticResource IconButton}" Content="&#xE892;" FontSize="15" Padding="10,6" Click="Prev_Click"/>
                                            <Button x:Name="PlayBtn" Style="{StaticResource IconButton}" Content="&#xE768;" FontSize="18" Padding="12,6" Margin="10,0" Click="Play_Click"/>
                                            <Button Style="{StaticResource IconButton}" Content="&#xE893;" FontSize="15" Padding="10,6" Click="Next_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Grid.Row="2" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="2" Padding="10,0,14,0">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="42"/>
                                        <ColumnDefinition Width="130"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="MuteBtn" Style="{StaticResource IconButton}" Content="&#xE767;" FontSize="13" Padding="6,3" Margin="0,0,6,0" Click="Mute_Click"/>
                                    <local:VolumeSlider x:Name="VolSlider" Grid.Column="1"/>
                                    <TextBlock x:Name="VolText" Grid.Column="2" FontFamily="{StaticResource Mono}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="OutputText" Grid.Column="3" Style="{StaticResource Tag}" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Right side: the pixel character above three quick actions -->
                            <Grid Grid.Column="2" Grid.RowSpan="3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="112"/>
                                </Grid.RowDefinitions>
                                <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="2" Padding="12,8,12,6">
                                    <Grid>
                                        <TextBlock x:Name="PetTag" Style="{StaticResource Tag}" VerticalAlignment="Top"/>
                                        <TextBlock x:Name="PetMood" Style="{StaticResource Tag}" VerticalAlignment="Top" HorizontalAlignment="Right"/>
                                        <!-- Place of the character; it is drawn on its own layer above the panel (PetLayer) -->
                                        <Border x:Name="PetSpot" Margin="0,16,0,0"/>
                                    </Grid>
                                </Border>
                                <UniformGrid x:Name="ActionsGrid" Grid.Row="2" Columns="3" Margin="-4,-4,-4,0"/>
                            </Grid>
                        </Grid>

                        <!-- Steuerung: big tiles and the icons of background apps -->
                        <Grid x:Name="ControlPage" Grid.Row="1" Margin="0,8,0,0" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="56"/>
                            </Grid.RowDefinitions>
                            <UniformGrid x:Name="ControlTiles" Margin="-4,-4,-4,0" Columns="4" Rows="2"/>
                            <Border Grid.Row="2" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="2" Padding="14,0">
                                <Grid>
                                    <TextBlock Text="HINTERGRUND-APPS" Style="{StaticResource Tag}" VerticalAlignment="Center"/>
                                    <WrapPanel x:Name="TrayIcons" Margin="120,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Mitteilungen: notifications, running apps, calendar -->
                        <ContentControl x:Name="NotifyPage" Grid.Row="1" Margin="0,8,0,0" Visibility="Collapsed" Focusable="False"/>
                    </Grid>
                </Grid>
                <!-- The pixel character, above the cached panel: its frames redraw only this small layer -->
                <Canvas x:Name="PetLayer" Width="820" Height="330" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <local:PixelPet x:Name="Pet"/>
                </Canvas>
            </Grid>
        </Border>
    </Grid>
</Window>
