<Window x:Class="DesktopOverlay.StartMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DesktopOverlay"
        Title="Start" Width="580" Height="640"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" Topmost="True"
        FontFamily="{DynamicResource Ui}" Foreground="White"
        Deactivated="Window_Deactivated" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="Tile" TargetType="Button">
            <Setter Property="local:Feedback.Press" Value="True"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="84"/>
            <Setter Property="Height" Value="88"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="2" Padding="4,8,4,4">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#12FFFFFF"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Line}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#2EFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Panel" Margin="10" CornerRadius="3" Background="{StaticResource GlassPanel}" BorderBrush="{StaticResource GlassRim}" BorderThickness="1"
            RenderTransformOrigin="0.5,1">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="Zoom"/>
                <TranslateTransform x:Name="Slide"/>
            </TransformGroup>
        </Border.RenderTransform>
        <Grid Margin="22,22,22,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="64"/>
            </Grid.RowDefinitions>

            <!-- Search -->
            <Border CornerRadius="2" Background="#0CFFFFFF" BorderBrush="{StaticResource LineHi}" BorderThickness="1" Height="38">
                <Grid Margin="14,0">
                    <TextBlock Text="&gt;" FontFamily="{StaticResource Mono}" FontSize="14" VerticalAlignment="Center" Foreground="{StaticResource Dim}"/>
                    <TextBox x:Name="Search" Margin="26,0,0,0" Background="Transparent" BorderThickness="0" Foreground="White"
                             CaretBrush="White" FontFamily="{StaticResource Mono}" FontSize="13" VerticalAlignment="Center" TextChanged="Search_TextChanged"/>
                    <TextBlock x:Name="Placeholder" Text="apps durchsuchen_" Margin="28,0,0,0" FontFamily="{StaticResource Mono}" FontSize="13" VerticalAlignment="Center"
                               Foreground="{StaticResource Dim}" IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" Margin="-6,14,-6,0" VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
                <StackPanel x:Name="Sections"/>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Margin="-22,0" CornerRadius="0,0,3,3" Background="#06FFFFFF" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                <Grid Margin="22,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="32" Height="32" CornerRadius="2" Background="#10FFFFFF" BorderBrush="{StaticResource LineHi}" BorderThickness="1">
                            <TextBlock Text="&#xE77B;" FontFamily="{StaticResource Icons}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="UserName" Margin="12,0,0,0" FontFamily="{StaticResource Mono}" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Content="&#xE713;" FontSize="16" Padding="10" Click="Settings_Click" ToolTip="Einstellungen"/>
                        <Button x:Name="PowerBtn" Style="{StaticResource IconButton}" Content="&#xE7E8;" FontSize="16" Padding="10" Click="Power_Click" ToolTip="Ein/Aus"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
