<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Onyx</AssemblyName>
    <RootNamespace>DesktopOverlay</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- Lean runtime: no background GC thread, workstation GC, only needed satellite languages -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <SatelliteResourceLanguages>de;en</SatelliteResourceLanguages>
    <Version>1.6.0</Version>
    <Product>Onyx</Product>
    <AssemblyTitle>Onyx</AssemblyTitle>
    <Company>Onyx</Company>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="ManagedShell" Version="0.0.374" />
    <PackageReference Include="System.Management" Version="10.0.2" />
  </ItemGroup>
</Project>
