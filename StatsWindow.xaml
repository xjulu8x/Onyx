<Window x:Class="DesktopOverlay.StatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stats" Width="250" SizeToContent="Height" Top="14"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize"
        FontFamily="{DynamicResource Ui}" Foreground="White"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale">
    <StackPanel x:Name="Blocks" Effect="{StaticResource TextShadow}" Margin="10">
        <!-- Network -->
        <Grid x:Name="Net" Margin="10,0,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="21"/><RowDefinition Height="21"/><RowDefinition Height="21"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Download" FontSize="15"/>
            <TextBlock Grid.Row="1" Text="Upload" FontSize="15"/>
            <TextBlock Grid.Row="2" Text="Ping" FontSize="15"/>
            <TextBlock x:Name="DownVal" Grid.Column="1" FontSize="12" VerticalAlignment="Center"/>
            <TextBlock x:Name="UpVal" Grid.Row="1" Grid.Column="1" FontSize="12" VerticalAlignment="Center"/>
            <TextBlock x:Name="PingVal" Grid.Row="2" Grid.Column="1" FontSize="12" VerticalAlignment="Center"/>
        </Grid>

        <!-- GPU temperature -->
        <!-- Fixed column widths so nothing shifts when the number of digits changes. -->
        <Grid x:Name="GpuBlock" HorizontalAlignment="Center" Margin="0,40,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44"/>
                <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>
            <!-- Graphics card: bracket, board with two fans, PCIe contacts -->
            <Viewbox Width="36" VerticalAlignment="Center" HorizontalAlignment="Left">
                <Canvas Width="32" Height="22">
                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M1,1 L1,21 M1,3 L4,3 M4,2 L30,2 Q31,2 31,3 L31,16 Q31,17 30,17 L4,17 Z M10,17 L10,20 L24,20 L24,17"/>
                    <Ellipse Canvas.Left="7" Canvas.Top="4.5" Width="10" Height="10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}" StrokeThickness="1.4"/>
                    <Ellipse Canvas.Left="19" Canvas.Top="4.5" Width="10" Height="10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}" StrokeThickness="1.4"/>
                    <Ellipse Canvas.Left="10.5" Canvas.Top="8" Width="3" Height="3" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <Ellipse Canvas.Left="22.5" Canvas.Top="8" Width="3" Height="3" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}"/>
                </Canvas>
            </Viewbox>
            <TextBlock x:Name="GpuTemp" Grid.Column="1" Text="0°" FontSize="32" FontWeight="Light" Margin="10,0,0,0" VerticalAlignment="Center"/>
        </Grid>

        <!-- CPU graph -->
        <StackPanel x:Name="CpuBlock">
        <Grid>
            <TextBlock Text="CPU" FontSize="14"/>
            <TextBlock x:Name="CpuVal" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
        <Canvas x:Name="CpuCanvas" Height="30" Margin="0,4,0,0" ClipToBounds="True">
            <Path x:Name="CpuFill">
                <Path.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#99FFFFFF" Offset="0"/>
                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Path.Fill>
            </Path>
            <Path x:Name="CpuLine" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}" StrokeThickness="1.4" StrokeLineJoin="Round"/>
        </Canvas>
        <Grid x:Name="CpuTrack" Height="10" Margin="0,8,0,0" Visibility="Collapsed">
            <Border Background="#1AFFFFFF" CornerRadius="2"/>
            <Border x:Name="CpuBarFill" CornerRadius="2" HorizontalAlignment="Left" Width="0"/>
        </Grid>
        <Grid x:Name="CpuRingBox" Width="64" Height="64" Margin="0,8,0,0" HorizontalAlignment="Left" Visibility="Collapsed">
            <Ellipse Stroke="#1AFFFFFF" StrokeThickness="6"/>
            <Path x:Name="CpuRing" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Grid>
        </StackPanel>

        <!-- RAM -->
        <StackPanel x:Name="RamBlock" Margin="0,18,0,0">
        <Grid>
            <TextBlock Text="RAM" FontSize="14"/>
            <TextBlock x:Name="RamVal" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
        <Grid x:Name="RamTrack" Height="10" Margin="0,8,0,0">
            <Border Background="#1AFFFFFF" CornerRadius="2"/>
            <Border x:Name="RamFill" CornerRadius="2" HorizontalAlignment="Left" Width="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00FFFFFF" Offset="0"/>
                        <GradientStop Color="#FFFFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
        </Grid>
        <Grid x:Name="RamRingBox" Width="64" Height="64" Margin="0,8,0,0" HorizontalAlignment="Left" Visibility="Collapsed">
            <Ellipse Stroke="#1AFFFFFF" StrokeThickness="6"/>
            <Path x:Name="RamRing" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Grid>
        </StackPanel>

        <!-- Disks -->
        <StackPanel x:Name="DiskList" Margin="0,18,0,0"/>
    </StackPanel>
</Window>
