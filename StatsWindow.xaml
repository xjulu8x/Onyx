<Window x:Class="DesktopOverlay.StatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stats" Width="250" SizeToContent="Height" Top="44"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize"
        FontFamily="{DynamicResource Ui}" Foreground="White"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale">
    <Border x:Name="Frame" Background="{StaticResource GlassPanel}" BorderBrush="{StaticResource GlassRim}" BorderThickness="1" CornerRadius="2" Padding="14,10,14,12">
    <DockPanel>
    <!-- Header like the reference widgets: "+ SYSTEM / 01" and a live mark -->
    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
        <TextBlock Text="+ SYSTEM / 01" Style="{StaticResource Tag}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Rectangle Width="5" Height="5" Fill="{StaticResource Signal}" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBlock Text="LIVE" Style="{StaticResource Tag}"/>
        </StackPanel>
    </Grid>
    <StackPanel x:Name="Blocks">
        <!-- Network -->
        <Grid x:Name="Net">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="21"/><RowDefinition Height="21"/><RowDefinition Height="21"/>
            </Grid.RowDefinitions>
            <TextBlock Text="DOWN" Style="{StaticResource Tag}" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="1" Text="UP" Style="{StaticResource Tag}" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="2" Text="PING" Style="{StaticResource Tag}" VerticalAlignment="Center"/>
            <TextBlock x:Name="DownVal" Grid.Column="1" FontFamily="{StaticResource Mono}" FontSize="11" VerticalAlignment="Center"/>
            <TextBlock x:Name="UpVal" Grid.Row="1" Grid.Column="1" FontFamily="{StaticResource Mono}" FontSize="11" VerticalAlignment="Center"/>
            <TextBlock x:Name="PingVal" Grid.Row="2" Grid.Column="1" FontFamily="{StaticResource Mono}" FontSize="11" VerticalAlignment="Center"/>
        </Grid>

        <!-- GPU temperature -->
        <!-- Fixed column widths so nothing shifts when the number of digits changes. -->
        <Grid x:Name="GpuBlock" HorizontalAlignment="Left" Margin="0,18,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44"/>
                <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>
            <!-- Graphics card: bracket, board with two fans, PCIe contacts -->
            <Viewbox Width="36" VerticalAlignment="Center" HorizontalAlignment="Left">
                <Canvas Width="32" Height="22">
                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M1,1 L1,21 M1,3 L4,3 M4,2 L30,2 Q31,2 31,3 L31,16 Q31,17 30,17 L4,17 Z M10,17 L10,20 L24,20 L24,17"/>
                    <Ellipse Canvas.Left="7" Canvas.Top="4.5" Width="10" Height="10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}" StrokeThickness="1.4"/>
                    <Ellipse Canvas.Left="19" Canvas.Top="4.5" Width="10" Height="10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}" StrokeThickness="1.4"/>
                    <Ellipse Canvas.Left="10.5" Canvas.Top="8" Width="3" Height="3" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <Ellipse Canvas.Left="22.5" Canvas.Top="8" Width="3" Height="3" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}"/>
                </Canvas>
            </Viewbox>
            <TextBlock x:Name="GpuTemp" Grid.Column="1" Text="0°" FontSize="34" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
        </Grid>

        <!-- CPU graph -->
        <StackPanel x:Name="CpuBlock">
        <Grid>
            <TextBlock Text="CPU" Style="{StaticResource Tag}"/>
            <TextBlock x:Name="CpuVal" FontFamily="{StaticResource Mono}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
        <Canvas x:Name="CpuCanvas" Height="30" Margin="0,4,0,0" ClipToBounds="True">
            <Path x:Name="CpuFill">
                <Path.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#99FFFFFF" Offset="0"/>
                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Path.Fill>
            </Path>
            <Path x:Name="CpuLine" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}" StrokeThickness="1.4" StrokeLineJoin="Round"/>
        </Canvas>
        <Grid x:Name="CpuTrack" Height="6" Margin="0,8,0,0" Visibility="Collapsed">
            <Border Background="#262626"/>
            <Border x:Name="CpuBarFill" HorizontalAlignment="Left" Width="0"/>
        </Grid>
        <Grid x:Name="CpuRingBox" Width="64" Height="64" Margin="0,8,0,0" HorizontalAlignment="Left" Visibility="Collapsed">
            <Ellipse Stroke="#262626" StrokeThickness="4" Margin="1"/>
            <Path x:Name="CpuRing" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}" StrokeThickness="4" StrokeStartLineCap="Flat" StrokeEndLineCap="Flat"/>
        </Grid>
        </StackPanel>

        <!-- RAM -->
        <StackPanel x:Name="RamBlock" Margin="0,14,0,0">
        <Grid>
            <TextBlock Text="RAM" Style="{StaticResource Tag}"/>
            <TextBlock x:Name="RamVal" FontFamily="{StaticResource Mono}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
        <Grid x:Name="RamTrack" Height="6" Margin="0,8,0,0">
            <Border Background="#262626"/>
            <Border x:Name="RamFill" HorizontalAlignment="Left" Width="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00FFFFFF" Offset="0"/>
                        <GradientStop Color="#FFFFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
        </Grid>
        <Grid x:Name="RamRingBox" Width="64" Height="64" Margin="0,8,0,0" HorizontalAlignment="Left" Visibility="Collapsed">
            <Ellipse Stroke="#262626" StrokeThickness="4" Margin="1"/>
            <Path x:Name="RamRing" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}" StrokeThickness="4" StrokeStartLineCap="Flat" StrokeEndLineCap="Flat"/>
        </Grid>
        </StackPanel>

        <!-- Disks -->
        <StackPanel x:Name="DiskList" Margin="0,14,0,0"/>
    </StackPanel>
    </DockPanel>
    </Border>
</Window>
