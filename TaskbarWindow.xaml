<Window x:Class="DesktopOverlay.TaskbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Taskbar" Height="50" Width="800"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" Topmost="True"
        FontFamily="{DynamicResource Ui}" Foreground="White">
    <Window.Resources>
        <Style x:Key="TrayButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid x:Name="Root" MouseRightButtonUp="Bar_RightClick">
        <!-- Dark, slightly see-through bar; rounded corners are anti-aliased by WPF since the window is per-pixel transparent. -->
        <!-- Even, soft rim; not pixel-snapped so the rounded corners stay smoothly anti-aliased -->
        <Border x:Name="Bg" CornerRadius="4" Background="#F00A0A0A" BorderThickness="1" BorderBrush="#333333" SnapsToDevicePixels="True"/>
        <!-- Form "Inseln": one surface per group, placed by UpdateShape -->
        <Border x:Name="BgMid" HorizontalAlignment="Left" Visibility="Collapsed"/>
        <Border x:Name="BgRight" HorizontalAlignment="Left" Visibility="Collapsed"/>

        <!-- Center: start + apps -->
        <StackPanel x:Name="CenterPanel" Orientation="Horizontal" HorizontalAlignment="Center">
            <Border x:Name="StartBtn" Width="46" Height="44" CornerRadius="2" Background="#01000000" Cursor="Hand"
                    MouseLeftButtonUp="Start_Click" MouseEnter="Hover_Enter" MouseLeave="Hover_Leave" ToolTip="Start">
                <Grid x:Name="StartLogo" Width="20" Height="20">
                    <Grid.Resources>
                        <LinearGradientBrush x:Key="Logo" StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#7CD3FF" Offset="0"/>
                            <GradientStop Color="#1E8CFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Grid.Resources>
                    <Rectangle Width="9" Height="9" RadiusX="0" RadiusY="0" Fill="{StaticResource Logo}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <Rectangle Width="9" Height="9" RadiusX="0" RadiusY="0" Fill="{StaticResource Logo}" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                    <Rectangle Width="9" Height="9" RadiusX="0" RadiusY="0" Fill="{StaticResource Logo}" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                    <Rectangle Width="9" Height="9" RadiusX="0" RadiusY="0" Fill="{StaticResource Logo}" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                </Grid>
            </Border>
            <StackPanel x:Name="AppsPanel" Orientation="Horizontal"/>
        </StackPanel>

        <!-- Right: tray -->
        <StackPanel x:Name="RightPanel" Visibility="Collapsed" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0" Effect="{StaticResource TextShadow}">
            <!-- Opens the window with the icons of background apps, like the arrow in Windows -->
            <Button x:Name="TrayBtn" Style="{StaticResource TrayButton}" Content="&#xE70E;" FontSize="11" Click="Tray_Click" ToolTip="Ausgeblendete Symbole" Visibility="Collapsed"/>
            <Button x:Name="NetBtn" Style="{StaticResource TrayButton}" Content="&#xE701;" Click="Network_Click" ToolTip="Netzwerk"/>
            <Button x:Name="VolBtn" Style="{StaticResource TrayButton}" Content="&#xE767;" Click="Volume_Click"
                    MouseWheel="Vol_Wheel" ToolTip="Lautst&#xE4;rke (Mausrad)"/>
            <Button Style="{StaticResource TrayButton}" Click="Center_Click" Padding="10,4" ToolTip="Aktivit&#xE4;tszentrum">
                <StackPanel>
                    <TextBlock x:Name="TimeText" FontFamily="{DynamicResource Ui}" FontSize="12" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="DateText" FontFamily="{DynamicResource Ui}" FontSize="11" HorizontalAlignment="Right" Foreground="{StaticResource Dim}"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
