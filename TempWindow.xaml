<Window x:Class="DesktopOverlay.TempWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Temp" SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize"
        FontFamily="{DynamicResource Ui}" Foreground="White"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale">
    <Border Background="{StaticResource GlassPanel}" BorderBrush="{StaticResource GlassRim}" BorderThickness="1" CornerRadius="2" Padding="14,10,14,12" MinWidth="236">
        <StackPanel>
            <Grid Margin="0,0,0,8">
                <TextBlock Text="+ CPU / TEMP" Style="{StaticResource Tag}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}"/>
                <TextBlock x:Name="Vendor" Style="{StaticResource Tag}" HorizontalAlignment="Right"/>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TempText" Text="--°" FontSize="38" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="14,0,0,6">
                    <TextBlock x:Name="Model" Style="{StaticResource Tag}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                    <!-- Heat as a text gauge, like "[|||||.....]" -->
                    <TextBlock x:Name="Gauge" FontFamily="{StaticResource Mono}" FontSize="11" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>
            <TextBlock x:Name="SubText" Style="{StaticResource Tag}" Cursor="Hand" Background="Transparent" TextWrapping="Wrap" MaxWidth="220" Margin="0,4,0,0"/>
        </StackPanel>
    </Border>
</Window>
